# ── Supabase (the database) — see SUPABASE_SETUP.md for a step-by-step guide ──
# When both are set, the app stores everything in Supabase. If unset, it falls
# back to local files (fine for testing only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service_role-key

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (AUD, recurring subscriptions)
#   ANNUAL      = $12 / year  — one charge per year   (96% efficient)
#   WEEKLY      = $4  / month — $1/week batched monthly (90% efficient)
#   FORTNIGHTLY = $2  / month — $1/fortnight batched   (~85% efficient)
#   MONTHLY     = $1  / month — single dollar charge   (65% efficient)
# Standard tier
STRIPE_PRICE_ANNUAL=price_...            # $12/year, one charge
STRIPE_PRICE_WEEKLY=price_...            # $1/week batched → $4/month, one charge (recommended)
STRIPE_PRICE_WEEKLY_TRUE=price_...       # $1/week billed weekly → 4 separate $1 charges/month
STRIPE_PRICE_FORTNIGHTLY=price_...       # $1/fortnight → $2/month, one charge
STRIPE_PRICE_MONTHLY=price_...           # $1/month, one charge

# Boosted tier — clean rounded amount that covers the Stripe fee
# so 100% of the standard amount reaches us.
#   ANNUAL_BOOST      = $13 / year
#   WEEKLY_BOOST      = $4.50 / month
#   FORTNIGHTLY_BOOST = $2.40 / month
#   MONTHLY_BOOST     = $1.30 / month
STRIPE_PRICE_ANNUAL_BOOST=price_...
STRIPE_PRICE_WEEKLY_BOOST=price_...
STRIPE_PRICE_WEEKLY_TRUE_BOOST=price_...
STRIPE_PRICE_FORTNIGHTLY_BOOST=price_...
STRIPE_PRICE_MONTHLY_BOOST=price_...

# In your Stripe dashboard, enable au_becs_debit as a payment method
# (Settings → Payment methods → BECS Direct Debit). It needs a verified
# Australian business profile. Card works out of the box.

# Session cookie signing — any random 32+ char string
SESSION_SECRET=change-me-to-a-long-random-string

# Admin dashboard password (protects /admin). If unset, /admin is blocked in
# production and open in local dev.
ADMIN_PASSWORD=change-me

# Public site URL (used for Stripe Checkout return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
